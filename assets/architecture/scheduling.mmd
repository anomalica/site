flowchart TB
  classDef asset fill:#D1F1F1,stroke:#0B6E6E,stroke-width:1.5px,color:#053333;
  classDef hub fill:#F0D9C9,stroke:#B35A28,stroke-width:1.6px,color:#3a2208;
  classDef branch fill:#E9E5DC,stroke:#5E5A50,stroke-width:1.3px,color:#2c2a24;

  source["A raw source"]:::asset
  record["A record"]:::asset
  digest["A digest"]:::asset
  inspection["Its inspection page"]:::branch
  kgraph[("THE knowledge graph<br/>(one, shared)")]:::hub
  brief["A brief<br/>(one per page)"]:::hub
  article["An article<br/>(+ translations)"]:::asset

  source -->|"ingester &nbsp; 1 source -> 1 record"| record
  record -->|"digester &nbsp; 1 record -> 1 digest"| digest
  digest -.->|"1:1 &nbsp; what we pulled from this one source"| inspection
  digest ==>|"assimilator &nbsp; MANY digests -> 1 graph &nbsp; (merge / fan-in)"| kgraph
  kgraph ==>|"synthesiser &nbsp; 1 graph -> MANY briefs &nbsp; (fan-out)"| brief
  brief -->|"assembler &nbsp; 1 brief -> 1 article"| article

  click source schedClick
  click record schedClick
  click digest schedClick
  click inspection schedClick
  click kgraph schedClick
  click brief schedClick
  click article schedClick
