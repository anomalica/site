{{- /* One page per brief.

     A brief is the list of claims the writer was given for an article - the
     step between the sources and the prose, which was previously invisible.
     The files live in the content repo and are mounted as data; this creates a
     page for each so a reader can be linked to one.

     The URL carries the section because the slug alone is not unique: AARO
     exists as both an organisation and a project, and a flat URL served one of
     them and silently dropped the other. This is the deliberate move the
     tripwire that caught it asked for - the deploy redirects every old flat
     brief URL to its sectioned one, except where the slug is ambiguous, which
     is the one case a redirect cannot answer honestly.

     Only the keys go into page params: the brief itself is looked up from
     site.Data.briefs in the layout, so 60MB of claims is not copied into every
     page's parameters. */ -}}
{{ range $section, $briefs := site.Data.briefs }}
  {{ range $slug, $brief := $briefs }}
    {{ with $brief.page }}
      {{/* "path" is relative to this section. */}}
      {{ $.AddPage (dict
        "path" (printf "%s/%s" $section $slug)
        "kind" "page"
        "title" .title
        "params" (dict "slug" $slug "section" $section "node_type" .node_type)
      ) }}
    {{ end }}
  {{ end }}
{{ end }}
