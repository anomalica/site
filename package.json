{
  "name": "site",
  "description": "Static website for Anomalica",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "vendor": "bash scripts/fetch-vendor.sh",
    "predev": "npm run vendor",
    "dev": "concurrently \"npx @tailwindcss/cli -i assets/css/main.css -o assets/css/compiled.css --watch\" \"hugo server\"",
    "prebuild": "npm run vendor",
    "build": "npx @tailwindcss/cli -i assets/css/main.css -o assets/css/compiled.css --minify && hugo --gc --minify -e production"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.1"
  }
}
