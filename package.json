{
  "name": "anomalica-site",
  "description": "Static website for Anomalica",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx @tailwindcss/cli -i assets/css/main.css -o assets/css/compiled.css --watch\" \"hugo server\"",
    "build": "npx @tailwindcss/cli -i assets/css/main.css -o assets/css/compiled.css --minify && hugo --gc --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.1"
  }
}
