{{- /* Site-wide search index, generated from the content at build time.

     The per-section listings each filter their own rows, so searching People
     could never find an organisation - and with 322 pages and rising, a reader
     who does not know which type a name belongs to has nowhere to start. This
     is the one index that covers everything.

     It is built from site.RegularPages, so it is correct on every build and
     cannot drift from what the site serves: a page that exists is in here, a
     page that does not cannot be. Nothing to maintain by hand.

     Each entry carries its own section LABEL rather than a code the header
     would have to look up: the index is built per language, so the label is
     already translated by the time it reaches the browser.

     Keys are single letters because they repeat once per page: t title,
     d description, u url, l section label, g tags. */ -}}
{{- $entries := slice -}}
{{- range site.RegularPages -}}
  {{- $tags := slice -}}
  {{- range .Params.tags }}{{ $tags = $tags | append . }}{{ end -}}
  {{- $entries = $entries | append (dict
      "t" .Title
      "d" (.Params.description | default "" | truncate 160 | htmlUnescape)
      "u" .RelPermalink
      "l" (T .Section | default (.Section | humanize))
      "g" $tags) -}}
{{- end -}}
{{- range site.Sections -}}
  {{- if .Pages -}}
    {{- $entries = $entries | append (dict
        "t" .Title
        "d" (.Params.description | default "")
        "u" .RelPermalink
        "l" ""
        "g" slice) -}}
  {{- end -}}
{{- end -}}
{{- $entries | jsonify -}}
